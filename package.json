{
  "name": "tonofcov",
  "version": "0.0.55",
  "description": "Source-line code coverage for TON smart contracts (FunC, Tolk planned). HTML report, conditional-throw branch coverage, agent-friendly gaps listing, and LCOV output for IDEs and CI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Skydev0h/tonofcov.git"
  },
  "bugs": {
    "url": "https://github.com/Skydev0h/tonofcov/issues"
  },
  "homepage": "https://github.com/Skydev0h/tonofcov#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "jest-preset.json",
    "CHANGELOG.md",
    "KNOWN_ARTIFACTS.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ton",
    "func",
    "tolk",
    "coverage",
    "lcov",
    "smart-contracts",
    "blockchain"
  ],
  "dependencies": {
    "@scaleton/tree-sitter-func": "^1.0.1",
    "web-tree-sitter": "^0.26.0"
  },
  "peerDependencies": {
    "@ton-community/func-js": ">=0.10.0",
    "@ton/blueprint": ">=0.41.0",
    "@ton/core": ">=0.63.0",
    "@ton/sandbox": ">=0.37.0",
    "jest": ">=29.0.0"
  },
  "devDependencies": {
    "@ton-community/func-js": "^0.11.0",
    "@ton/blueprint": "^0.44.2",
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@ton/sandbox": "^0.41.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ton-assembly": "^0.6.1",
    "typescript": "^5.6.0"
  }
}
